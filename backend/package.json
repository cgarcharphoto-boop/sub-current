{
  "name": "subcurrent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subcurrent API \u2014 fans, tickets, teams/owner portal. SQLite by default; swap to Postgres by changing DATABASE_URL.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "rm -f test.db && DATABASE_URL=file:./test.db npx prisma db push --skip-generate",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "vapid:generate": "node scripts/generate-vapid.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "prisma": "^5.20.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "stripe": "^16.12.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}